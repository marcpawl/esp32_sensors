CMakeCache.txt
CMakeFiles/
compile_commands.json

# IDE / editor
#
# CLion configuration is handled by *explicitly listing* each file rather than
# ignoring the whole `.idea/` directory and whitelisting a few. This keeps every
# decision visible: a new file is neither silently tracked nor silently
# ignored. Files fall into three buckets:
#
#   * TRACKED in git (shared, reproducible build/refactor workflow):
#       .idea/.gitignore                   local-ignore rules for this dir
#       .idea/cmake.xml                    CMake profiles
#       .idea/editor.xml                   editor settings
#       .idea/esp32_sensors.iml            module definition
#       .idea/misc.xml                     project SDK / misc
#       .idea/modules.xml                  module registry
#       .idea/vcs.xml                      VCS mapping
#       .idea/codeStyles/Project.xml               shared code style
#       .idea/codeStyles/codeStyleConfig.xml       which style is active
#       .idea/runConfigurations/*.xml      run/debug configurations
#
#   * EXPLICITLY IGNORED (local, machine-specific state). Individual files are
#     listed deliberately; directories are only listed when their file *names*
#     are meaningless/generated, so meaningful new files stay visible:
#
#     .idea/workspace.xml         per-machine window/layout/recent state
#     .idea/shelf/                local shelves: patch content is machine-local
#     .idea/httpRequests/         local scratch HTTP requests
#     .idea/usage.statistics.xml  per-machine usage stats
#     .idea/tasks.xml             local task list
#     .idea/remote-targets.xml    local SSH/remote target state
#     .idea/dataSources.local.xml local DB credentials
#     .idea/sqldialects.xml       local SQL dialect overrides
#     .idea/markdown-navigator/   generated markdown preview cache
#     .idea/dataSources/          UUID-named generated datasource metadata
.idea/workspace.xml
.idea/shelf/
.idea/httpRequests/
.idea/usage.statistics.xml
.idea/tasks.xml
.idea/remote-targets.xml
.idea/dataSources.local.xml
.idea/sqldialects.xml
.idea/markdown-exported-files.xml
.idea/markdown-navigator.xml
.idea/markdown-navigator/
.idea/dataSources/
#
#   * NOT LISTED HERE means it is a NEW file whose fate is undecided: it will
#     appear as untracked in `git status`, prompting an explicit decision to
#     either `git add` it (shared) or add it to the ignore list above (local).
#
# `.idea/.gitignore` also ignores its own locals; see the file for details.
.vscode/
*.swp
*.swo
*~

# OS cruft
.DS_Store
Thumbs.db

# Host-side scratch directory bind-mounted as the container /tmp (see
# docker-compose.yml).
/tmp/
