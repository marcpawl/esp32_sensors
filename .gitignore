# ESP-IDF build output (firmware at the root, host tests under test/)
build/
test/build/
managed_components/
dependencies.lock

# Generated project configuration.
# sdkconfig is produced from sdkconfig.defaults by `idf.py`; keep only the
# committed defaults (sdkconfig.defaults) under version control.
sdkconfig
test/sdkconfig
sdkconfig.old
test/sdkconfig.old

# CMake / ninja ephemera
CMakeCache.txt
CMakeFiles/
compile_commands.json

# IDE / editor
# `.idea/` is ignored wholesale, then specific shared CLion configuration is
# un-ignored below (run configurations, module) so the container workflow is
# reproducible across machines. See .idea/.gitignore for workspace-local state.
.idea/*
!.idea/runConfigurations/
!.idea/.gitignore
!.idea/editor.xml
!.idea/esp32_sensors.iml
!.idea/modules.xml
!.idea/vcs.xml
.vscode/
*.swp
*.swo
*~

# OS cruft
.DS_Store
Thumbs.db

# Local Continue CLI / agent state (install.sh artifact is committed, state is not)
.continue/.cache/
