# ESP-IDF build output. The repo root is not an ESP-IDF project; it aggregates
# the subprojects (mcgowan/, plus the HAL, wrapper, logic, and simulator suites
# and the simulator application under components/), and each subproject keeps
# its build tree inside its own directory, named after the target so the
# firmware (esp32s3) and host-test (linux) builds stay separate:
#
#   mcgowan/build_esp32s3/        ESP32-S3 firmware (mcgowan.bin)
#   components/hal/tests/test-hal-stub/build_linux/    host tests for hal/hal_stub
#   components/hal/tests/test-hal-common/build_linux/  host tests for hal/hal_common
#   components/logic/tests/test-logic/build_linux/
#                                 host unit tests for components/logic/liblogic
#   components/espidfcpp/tests/test-espidf-cpp/build_linux/
#                                 host tests for components/espidfcpp/libespidfcpp
#   components/simulator/tests/test-simulator/build_linux/
#                                 host tests for components/simulator/libsimulator
#   components/simulator/exe/donny/build_linux/
#                                 linux-emulated application (donny)
#
# The root aggregator's own CMake/Ninja tree (scripts/dev.py build).
build_root/
build_esp32s3/
build_linux/
# CLion's own CMake build tree (see .idea/cmake.xml).
cmake-build-*/
components/logic/tests/test-logic/build_linux/
components/hal/tests/test-hal-stub/build_linux/
components/hal/tests/test-hal-common/build_linux/
components/espidfcpp/tests/test-espidf-cpp/build_linux/
components/simulator/tests/test-simulator/build_linux/
components/simulator/exe/donny/build_linux/
managed_components/
dependencies.lock

# Python bytecode caches (scripts/). Generated by py_compile / imports.
__pycache__/
*.pyc

# Generated project configuration.
# sdkconfig is produced from sdkconfig.defaults by `idf.py`; keep only the
# committed defaults (sdkconfig.defaults) under version control.
# One per ESP-IDF project (mcgowan/, and the suites and application under
# components/), plus the root aggregator's.
sdkconfig
mcgowan/sdkconfig
components/hal/tests/test-hal-stub/sdkconfig
components/hal/tests/test-hal-common/sdkconfig
components/logic/tests/test-logic/sdkconfig
components/espidfcpp/tests/test-espidf-cpp/sdkconfig
components/simulator/tests/test-simulator/sdkconfig
components/simulator/exe/donny/sdkconfig
sdkconfig.old
mcgowan/sdkconfig.old
components/hal/tests/test-hal-stub/sdkconfig.old
components/hal/tests/test-hal-common/sdkconfig.old
components/logic/tests/test-logic/sdkconfig.old
components/espidfcpp/tests/test-espidf-cpp/sdkconfig.old
components/simulator/tests/test-simulator/sdkconfig.old
components/simulator/exe/donny/sdkconfig.old

