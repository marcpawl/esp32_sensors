# On-target (ESP32-S3) target for the `esp_timer` test suite.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_IDF_TARGET_ESP32S3=y

# Keep logging quiet during test runs; Unity prints the results we care about.
CONFIG_LOG_DEFAULT_LEVEL_WARN=y

# The shared cases assert on the 64-bit values `esp_timer` returns
# (`int64_t` microseconds). Without this, every INT64/UINT64 assertion fails at
# run time with "Unity 64-bit Support Disabled".
CONFIG_UNITY_ENABLE_64BIT=y
