# clang-format configuration for the ESP32 sensors firmware.
#
# Style: Google base, 4-space indent, 80-column limit. Function definitions
# whose body does not fit on one line put the opening brace on its own line;
# every other brace stays attached. Verify with `./scripts/dev.py format-check`.
#
# See https://clang.llvm.org/docs/ClangFormatStyleOptions.html for the full set
# of options.
---
Language: Cpp
BasedOnStyle: Google

# --- Layout -----------------------------------------------------------------
IndentWidth: 4
TabWidth: 4
UseTab: Never
ColumnLimit: 80
AccessModifierOffset: -2

# Function definitions that do not fit on one line wrap the opening brace onto
# its own line. Short inline functions still fit on one line. All other braces
# stay attached, as in the Google base style.
BreakBeforeBraces: Custom
BraceWrapping:
  AfterFunction: true
AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: false
AllowShortLoopsOnASingleLine: false
AllowShortCaseLabelsOnASingleLine: false
AllowShortBlocksOnASingleLine: Never

# --- Includes ---------------------------------------------------------------
# Matches the existing convention: the translation unit's own header first, then
# a blank line, then standard library, then third-party/ESP-IDF, then project
# headers. Sorted within each group.
SortIncludes: CaseSensitive
IncludeBlocks: Preserve

# --- Pointer and reference alignment ----------------------------------------
# The firmware uses `Type& name` / `Type* name`.
PointerAlignment: Left
ReferenceAlignment: Pointer

# --- C++ --------------------------------------------------------------------
Standard: c++20 # clang-format has no c++26 token set; c++20 parses the
                # constructs used here (no C++23+ syntax in this codebase).
DerivePointerAlignment: false
SpaceAfterTemplateKeyword: false
SpaceBeforeParens: ControlStatements
SpaceInEmptyParentheses: false
SpacesInAngles: Never

# Suffix the `i`/`U`/`ULL` literal and keep `u`/`U` int types lowercase-free of
# spaces, e.g. `1000000ULL`, `0xF`.
SpaceBeforeParensOptions:
  AfterControlStatements: true
  AfterFunctionDeclarationName: false
  AfterFunctionDefinitionName: false

# Trailing return / namespace closing comments are hand-written; leave them.
FixNamespaceComments: true
NamespaceIndentation: None

# --- Misc -------------------------------------------------------------------
# Keep the em-dash/§/µ Unicode characters in comments intact.
# (Standard: Any would prevent clang-format from worrying about encoding.)
MaxEmptyLinesToKeep: 1
EmptyLineBeforeAccessModifier: Leave
SeparateDefinitionBlocks: Always
