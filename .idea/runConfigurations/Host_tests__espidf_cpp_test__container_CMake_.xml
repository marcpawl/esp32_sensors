<?xml version="1.0" encoding="UTF-8"?>
<!--
  Shared CLion run configuration for the `espidf_cpp` wrapper tests
  (`espidf-cpp-test/`).

  A native CLion *CMake* run configuration (not a shell script): CLion builds
  `esp32_sensors_espidf_cpp_tests.elf` from the "Host tests (espidf-cpp-test)"
  profile in .idea/cmake.xml. Selecting it makes that profile active, so the
  IDE's resolve configuration for `components/espidf_cpp` is the `linux`-target
  one - which is what its tests and the linux app assume.

  This configuration *builds* the tests. To run them use "Host unit tests
  (container)" (`scripts/dev.py test`), which also covers this suite.

  TARGET_NAME and CONFIG_NAME must both exist: the ELF target is defined by
  `espidf-cpp-test/` and the profile name must match .idea/cmake.xml.
-->
<component name="ProjectRunConfigurationManager">
  <configuration default="false" name="Host tests (espidf-cpp-test, container CMake)" type="CMakeRunConfiguration" factoryName="Application" REDIRECT_INPUT="false" ELEVATE="false" USE_EXTERNAL_CONSOLE="false" EMULATE_TERMINAL="false" PASS_PARENT_ENVS_2="true" PROJECT_NAME="esp32_sensors" TARGET_NAME="esp32_sensors_espidf_cpp_tests.elf" CONFIG_NAME="Host tests (espidf-cpp-test)" RUN_PATH="$CTest$">
    <method v="2">
      <option name="com.jetbrains.cidr.execution.CidrBuildBeforeRunTaskProvider$BuildBeforeRunTask" enabled="true" />
    </method>
  </configuration>
</component>
