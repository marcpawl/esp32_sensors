<?xml version="1.0" encoding="UTF-8"?>
<!--
  Shared CLion run configuration for the `libutility` container tests
  (`components/utility/tests/test-utility/`).

  A native CLion *CMake* run configuration (not a shell script): CLion builds
  `test-utility_build` (the root aggregator's target that runs `idf.py build`
  in `components/utility/tests/test-utility/`) from the "Host tests
  (utility-test)" profile in .idea/cmake.xml. Selecting it makes that profile
  active, so the IDE's resolve configuration for `components/utility/libutility`
  is the `linux`-target one.

  This configuration *builds* the tests. To run them use "Host unit tests
  (container)" (`scripts/dev.py test`) or `scripts/dev.py test-utility`.

  TARGET_NAME must be a target of the CMake project named by PROJECT_NAME -
  that is, of the ROOT aggregator, not of `test-utility/`. The root only
  defines `<subproject>_build` custom targets, so `test-utility_build` is the
  reachable name and `test-utility.elf` (an ESP-IDF target of the subproject's
  own CMake project) is not; naming the ELF fails with "cannot find target".
  CONFIG_NAME must name an *existing* profile from .idea/cmake.xml.
  PROJECT_NAME must be the root CMake project's name
  (`esp32_sensors_subprojects`, from the root `project()`): a CMake run
  configuration is bound to one CMake project, and a stale name here is another
  way to get "cannot find any profile"/target. CLion rewrites this attribute
  whenever it re-resolves the project, so keep it correct rather than letting
  the IDE discover it for you.
-->
<component name="ProjectRunConfigurationManager">
  <configuration default="false" name="Host tests (utility-test, container CMake)" type="CMakeRunConfiguration" factoryName="Application" REDIRECT_INPUT="false" ELEVATE="false" USE_EXTERNAL_CONSOLE="false" EMULATE_TERMINAL="false" PASS_PARENT_ENVS_2="true" PROJECT_NAME="esp32_sensors_subprojects" TARGET_NAME="test-utility_build" CONFIG_NAME="Host tests (utility-test)" RUN_PATH="$CTest$">
    <method v="2">
      <option name="com.jetbrains.cidr.execution.CidrBuildBeforeRunTaskProvider$BuildBeforeRunTask" enabled="true" />
    </method>
  </configuration>
</component>
