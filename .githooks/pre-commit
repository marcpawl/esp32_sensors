#!/usr/bin/env python3
#
# pre-commit hook. Four gates, all delegated to scripts/dev.py (the single
# source of truth for container/lint/test tasks):
#
#   1. `pycodestyle` — reject the commit if any Python source is not PEP 8
#      clean (pycodestyle's defaults: 79 columns). Runs first because it is the
#      cheapest gate by far, so a long line or a stray blank line is reported
#      before clang-tidy, clang-format, or the test suite start.
#   2. `clang-tidy` — reject the commit if static analysis reports a finding
#      (clang-diagnostic-*, clang-analyzer-*) in our own sources. Runs before
#      the slower gates so an analyzer finding is reported early.
#   3. `format-check-staged` — reject the commit if any staged C/C++ source is
#      not clang-format clean (style governed by the committed .clang-format).
#      That command runs clang-format on the *staged* content of each changed
#      file, so it never complains about unrelated working-tree edits.
#   4. `test` — reject the commit unless the full test suite passes
#      (`./scripts/dev.py test`). A red test run is a broken build; never
#      commit.
#
# `clang-tidy` analyzes the projects' existing build trees, so run
# `./scripts/dev.py build` at least once (and after pulling) or the gate stops
# with "no compile_commands.json ... run scripts/dev.py build <project>".
#
# Install once per clone (activates the version-controlled hooks dir):
#     git config core.hooksPath .githooks
#
# Bypass for a single commit (use sparingly):
#     git commit --no-verify
#
"""Delegate the pycodestyle, clang-tidy, clang-format, and test checks."""

from __future__ import annotations

import subprocess
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent


def run_check(dev: Path, subcommand: str) -> int:
    """Run `scripts/dev.py <subcommand>` from the repo root."""
    command = (sys.executable, str(dev), subcommand)
    print(f"command={command}")
    return subprocess.run(command, cwd=REPO_ROOT).returncode


def main() -> int:
    dev = REPO_ROOT / "scripts" / "dev.py"
    if not dev.exists():
        print(
            f"pre-commit: {dev} not found; skipping pycodestyle, tidy, format "
            "and test checks.",
            file=sys.stderr,
        )
        return 0

    # 1. Python style (pycodestyle): the cheapest gate, so it runs first and a
    #    trivially fixable finding does not wait behind the others.
    rc = run_check(dev, "pycodestyle")
    if rc != 0:
        print(
            "pre-commit: `./scripts/dev.py pycodestyle` reported findings — "
            "commit rejected.\n"
            "            (bypass with `git commit --no-verify` if you must)",
            file=sys.stderr,
        )
        return rc

    # 2. Static analysis (clang-tidy): runs before the format and test gates
    #    so an analyzer finding is reported before them.
    rc = run_check(dev, "clang-tidy")
    if rc != 0:
        print(
            "pre-commit: `./scripts/dev.py clang-tidy` reported findings — "
            "commit rejected.\n"
            "            (bypass with `git commit --no-verify` if you must)",
            file=sys.stderr,
        )
        return rc

    # 3. Staged clang-format check (fast; runs before the test suite).
    rc = run_check(dev, "format-check-staged")
    if rc != 0:
        return rc

    # 4. Full test suite: `./scripts/dev.py test` must pass before committing.
    rc = run_check(dev, "test")
    if rc != 0:
        print(
            "pre-commit: `./scripts/dev.py test` failed — commit rejected.\n"
            "            (bypass with `git commit --no-verify` if you must)",
            file=sys.stderr,
        )
        return rc

    return 0


if __name__ == "__main__":
    sys.exit(main())
