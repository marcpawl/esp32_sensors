#!/usr/bin/env python3
#
# pre-commit hook: reject a commit if any staged C/C++ source is not
# clang-format clean (style governed by the committed .clang-format).
#
# Install once per clone (activates the version-controlled hooks dir):
#     git config core.hooksPath .githooks
#
# The check itself lives in scripts/dev.py (`format-check-staged`), the single
# source of truth for container/lint tasks. That command runs clang-format on
# the *staged* content of each changed file, so it never complains about
# unrelated working-tree edits.
#
# Bypass for a single commit (use sparingly):
#     git commit --no-verify
#
"""Delegate the staged clang-format check to scripts/dev.py."""

from __future__ import annotations

import subprocess
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent


def main() -> int:
    dev = REPO_ROOT / "scripts" / "dev.py"
    if not dev.exists():
        print(
            f"pre-commit: {dev} not found; skipping clang-format check.",
            file=sys.stderr,
        )
        return 0
    return subprocess.run(
        (sys.executable, str(dev), "format-check-staged"),
        cwd=REPO_ROOT,
    ).returncode


if __name__ == "__main__":
    sys.exit(main())
