# Project-wide clang-tidy configuration.
#
# `scripts/dev.py clang-tidy` supplies `--header-filter` and
# `--warnings-as-errors=*` on its own command line, so this file is what an
# editor or a bare `clang-tidy` invocation reads.
#
# `Checks` opts in to the categories this repository enforces. Everything is
# disabled first, so a category cannot arrive silently with a tool upgrade.
Checks: >
  -*
  ,clang-analyzer-*
  ,bugprone-*
  ,performance-*
  ,portability-*
  ,-portability-avoid-pragma-once
  ,-bugprone-easily-swappable-parameters
  ,cppcoreguidelines-avoid-goto
  ,cppcoreguidelines-explicit-constructor
  ,modernize-use-nullptr
  ,modernize-use-override
  ,modernize-use-using

WarningsAsErrors: '*'
HeaderFilterRegex: '.*/(mcgowan|components|donny|test-[^/]+)/.*'
SystemHeaders: false
FormatStyle: file

# Naming options take effect only when a `readability-identifier-naming` check
# is enabled; they are kept for editors that turn one on.
CheckOptions:
  - key: readability-identifier-naming.VariableCase
    value: lower_case
  - key: readability-identifier-naming.FunctionCase
    value: lower_case
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  - key: readability-identifier-naming.StructCase
    value: CamelCase
