# Keep the Docker build context small and reproducible.
.git
.idea
.continue
AGENTS.md
*.md
docker-compose.yml
Dockerfile
.dockerignore

# ESP-IDF build output and local state (never needed inside the image). Each
# subproject (mcgowan/, donny/, and the suites under components/) keeps its
# build tree inside its directory.
build_root/
build_*/
*/build_*/
components/espidfcpp/tests/test-espidf-cpp/build_linux/
components/logic/tests/test-logic/build_linux/
managed_components/
sdkconfig
sdkconfig.old
*/sdkconfig
*/sdkconfig.old
dependencies.lock

# Local caches / editor noise
# NOTE: .devcontainer/ is deliberately NOT ignored — the Dev Container
# definition must stay in the build context for `devcontainer up` / CLion.
.vscode/
*.swp
